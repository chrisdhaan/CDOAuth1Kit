{"primaryContentSections":[{"content":[{"anchor":"Create-a-session-manager","type":"heading","level":2,"text":"Create a session manager"},{"inlineContent":[{"text":"Initialize a session manager with your OAuth provider’s base URL and your app’s consumer credentials:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import CDOAuth1Kit","","let manager = CDOAuth1SessionManager(","    baseURL: URL(string: \"https:\/\/api.example.com\/oauth\/\")!,","    consumerKey: \"YOUR_CONSUMER_KEY\",","    consumerSecret: \"YOUR_CONSUMER_SECRET\"",")"]},{"anchor":"Fetch-a-request-token","type":"heading","level":2,"text":"Fetch a request token"},{"inlineContent":[{"text":"The first step of OAuth 1.0a is obtaining a request token:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let requestToken = try await manager.fetchRequestToken(","    path: \"request_token\",","    method: \"POST\",","    callbackURL: URL(string: \"yourapp:\/\/oauthCallback\")!",")"]},{"inlineContent":[{"text":"Then redirect the user to authorize your app on the OAuth provider’s website:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let authURLString = \"https:\/\/api.example.com\/oauth\/authorize?oauth_token=\\(requestToken.token)\"","if let authURL = URL(string: authURLString) {","    UIApplication.shared.open(authURL)","}"]},{"anchor":"Handle-the-callback-URL","type":"heading","level":2,"text":"Handle the callback URL"},{"inlineContent":[{"text":"When the user authorizes your app, they are redirected back to your app’s callback URL with an ","type":"text"},{"code":"oauth_verifier","type":"codeVoice"},{"text":" parameter.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Register your callback URL scheme in your app’s ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["<key>CFBundleURLTypes<\/key>","<array>","    <dict>","        <key>CFBundleURLName<\/key>","        <string>OAuth Callback<\/string>","        <key>CFBundleURLSchemes<\/key>","        <array>","            <string>yourapp<\/string>","        <\/array>","    <\/dict>","<\/array>"],"syntax":"xml"},{"inlineContent":[{"text":"Handle the callback in ","type":"text"},{"code":"SceneDelegate.scene(_:openURLContexts:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func scene(","    _ scene: UIScene,","    openURLContexts URLContexts: Set<UIOpenURLContext>",") {","    for urlContext in URLContexts {","        let url = urlContext.url","        ","        if CDOAuth1Helper.isAuthorizationCallbackURL(","            url,","            scheme: \"yourapp\",","            host: \"oauthCallback\"","        ) {","            \/\/ Extract oauth_token and oauth_verifier from url.query","            let params = [String: String](queryString: url.query ?? \"\")","            let verifier = params[\"oauth_verifier\"]","            ","            \/\/ Proceed to fetch access token (see next step)","        }","    }","}"]},{"anchor":"Fetch-the-access-token","type":"heading","level":2,"text":"Fetch the access token"},{"inlineContent":[{"type":"text","text":"Once you have the "},{"type":"codeVoice","code":"oauth_verifier"},{"type":"text","text":", exchange it for an access token:"}],"type":"paragraph"},{"syntax":"swift","code":["let accessToken = try await manager.fetchAccessToken(","    path: \"access_token\",","    method: \"POST\",","    requestToken: verifiedRequestToken  \/\/ request token with verifier added",")"],"type":"codeListing"},{"inlineContent":[{"text":"The access token is automatically stored in the device keychain. You can now use it for authenticated API requests.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Check-authorization-status","level":2,"text":"Check authorization status"},{"type":"paragraph","inlineContent":[{"