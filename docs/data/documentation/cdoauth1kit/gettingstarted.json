{"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/CDOAuth1Kit\/documentation\/CDOAuth1Kit"]]},"abstract":[{"text":"Authenticate with an OAuth 1.0a API in four steps.","type":"text"}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"CDOAuth1Kit"}],"title":"Getting Started"},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/CDOAuth1Kit\/documentation\/CDOAuth1Kit\/GettingStarted","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"anchor":"Create-a-session-manager","level":2,"type":"heading","text":"Create a session manager"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize a session manager with your OAuth provider’s base URL and your app’s consumer credentials:"}]},{"type":"codeListing","syntax":"swift","code":["import CDOAuth1Kit","","let manager = CDOAuth1SessionManager(","    baseURL: URL(string: \"https:\/\/api.example.com\/oauth\/\")!,","    consumerKey: \"YOUR_CONSUMER_KEY\",","    consumerSecret: \"YOUR_CONSUMER_SECRET\"",")"]},{"anchor":"Fetch-a-request-token","level":2,"type":"heading","text":"Fetch a request token"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first step of OAuth 1.0a is obtaining a request token:"}]},{"type":"codeListing","syntax":"swift","code":["let requestToken = try await manager.fetchRequestToken(","    path: \"request_token\",","    method: \"POST\",","    callbackURL: URL(string: \"yourapp:\/\/oauthCallback\")!",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then redirect the user to authorize your app on the OAuth provider’s website:"}]},{"type":"codeListing","syntax":"swift","code":["let authURLString = \"https:\/\/api.example.com\/oauth\/authorize?oauth_token=\\(requestToken.token)\"","if let authURL = URL(string: authURLString) {","    UIApplication.shared.open(authURL)","}"]},{"anchor":"Handle-the-callback-URL","level":2,"type":"heading","text":"Handle the callback URL"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the user authorizes your app, they are redirected back to your app’s callback URL with an "},{"type":"codeVoice","code":"oauth_verifier"},{"type":"text","text":" parameter."}]},{"type":"paragraph","inlineContent":[{"text":"Register your callback URL scheme in your app’s ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["<key>CFBundleURLTypes<\/key>","<array>","    <dict>","        <key>CFBundleURLName<\/key>","        <string>OAuth Callback<\/string>","        <key>CFBundleURLSchemes<\/key>","        <array>","            <string>yourapp<\/string>","        <\/array>","    <\/dict>","<\/array>"],"type":"codeListing","syntax":"xml"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle the callback in "},{"type":"codeVoice","code":"SceneDelegate.scene(_:openURLContexts:)"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["func scene(","    _ scene: UIScene,","    openURLContexts URLContexts: Set<UIOpenURLContext>",") {","    for urlContext in URLContexts {","        let url = urlContext.url","        ","        if CDOAuth1Helper.isAuthorizationCallbackURL(","            url,","            scheme: \"yourapp\",","            host: \"oauthCallback\"","        ) {","            \/\/ Extract oauth_token and oauth_verifier from url.query","            let params = [String: String](queryString: url.query ?? \"\")","            let verifier = params[\"oauth_verifier\"]","            ","            \/\/ Proceed to fetch access token (see next step)","        }","    }","}"]},{"anchor":"Fetch-the-access-token","level":2,"type":"heading","text":"Fetch the access token"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once you have the "},{"type":"codeVoice","code":"oauth_verifier"},{"type":"text","text":", exchange it for an access token:"}]},{"type":"codeListing","syntax":"swift","code":["let accessToken = try await manager.fetchAccessToken(","    path: \"access_token\",","    method: \"POST\",","    requestToken: verifiedRequestToken  \/\/ request token with verifier added",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The access token is automatically stored in the device keychain. You can now use it for authenticated API requests."}]},{"type":"heading","anchor":"Check-authorization-status","text":"Check authorization status","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"At any time, check if your app has a valid access token:"}]},{"type":"codeListing","syntax":"swift","code":["if manager.isAuthorized {","    print(\"User is logged in\")","} else {","    print(\"User needs to log in\")","}"]},{"anchor":"Next-steps","level":2,"type":"heading","text":"Next steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"See "},{"identifier":"https:\/\/github.com\/chrisdhaan\/CDOAuth1Kit\/blob\/master\/Documentation\/Usage.md","type":"reference","isActive":true},{"type":"text","text":" for comprehensive usage examples"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"See "},{"identifier":"https:\/\/github.com\/chrisdhaan\/CDOAuth1Kit\/blob\/master\/Documentation\/ARCHITECTURE.md","type":"reference","isActive":true},{"type":"text","text":" for implementation details"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"See "},{"identifier":"https:\/\/github.com\/chrisdhaan\/CDOAuth1Kit\/blob\/master\/Documentation\/CDOAuth1Kit%202.0%20Migration%20Guide.md","type":"reference","isActive":true},{"type":"text","text":" if upgrading from v1.0.0"}],"type":"paragraph"}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/cdoauth1kit\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://CDOAuth1Kit/documentation/CDOAuth1Kit":{"title":"CDOAuth1Kit","role":"collection","abstract":[{"text":"A pure-Swift, zero-dependency OAuth 1.0a library for i